# Haven Pet — Environment Variables
# Copy this file to .env and fill in your values

# Database (SQLite for local dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///./haven_pet.db
# DATABASE_URL=postgresql+asyncpg://havenpet:havenpet@localhost:5432/havenpet

# JWT Auth
JWT_SECRET=change-me-to-a-strong-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI (optional — app works with mock responses if not set)
ANTHROPIC_API_KEY=

# CORS
FRONTEND_URL=http://localhost:5173

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Email (stub — logs to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@havenpet.com
